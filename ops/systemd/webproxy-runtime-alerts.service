[Unit]
Description=Film4K Webproxy runtime readiness and crawler-lag check
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=WEBPROXY_BASE_URL=http://127.0.0.1:8090
Environment=CRAWLER_MAX_LAG_SECONDS=93600
Environment=CRAWLER_STARTUP_GRACE_SECONDS=7200
Environment=STATE_FILE=/var/lib/webproxy-runtime-alerts/state.json
EnvironmentFile=/etc/webproxy-runtime-alerts.env
StateDirectory=webproxy-runtime-alerts
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/libexec/webproxy-runtime-alerts.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webproxy-runtime-alerts
